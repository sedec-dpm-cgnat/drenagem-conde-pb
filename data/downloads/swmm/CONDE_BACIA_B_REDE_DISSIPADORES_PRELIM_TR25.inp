[TITLE]
;; CONDE - BACIA A - rede importada e areas preliminares
;; Modelo conceitual: validar topologia, cotas, diametros, nos de saida e quadras antes de uso decisorio.

[OPTIONS]
FLOW_UNITS           CMS
INFILTRATION         CURVE_NUMBER
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        YES
SKIP_STEADY_STATE    NO
START_DATE           01/01/2026
START_TIME           00:00:00
END_DATE             01/01/2026
END_TIME             06:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
WET_STEP             00:01:00
REPORT_STEP          00:01:00
RULE_STEP            00:01:00
INERTIAL_DAMPING     PARTIAL
VARIABLE_STEP        0.0
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS            8
HEAD_TOLERANCE       0.0015
THREADS              4

[EVAPORATION]
;; Evaporacao nao e relevante para o evento de projeto preliminar.
CONSTANT             0

[RAINGAGES]
;; Name                 Format  Interval SCF  Source
RG_TR25             INTENSITY 0:05 1.0 TIMESERIES TS_TR25

